# Whisper 模型設定 —— 改完重新 docker compose up -d --build (改 .env 只需 up -d)
# 模型選項: tiny / base / small / medium / large-v3
MODEL=medium

# 執行裝置: cuda (GPU) 或 cpu
DEVICE=cuda

# 量化精度: GPU 建議 int8 (省 VRAM) 或 float16; CPU 用 int8
COMPUTE_TYPE=int8

# 批次大小預設值 (前端每次仍可單獨選):
#   1 = 不批次, 最省電最安靜  /  4 = 平衡  /  8 = 最快最熱
# 整季 RSS 長時間跑建議 1~4
BATCH_SIZE=4

# 語言: 留空=自動偵測, 中文填 zh, 英文 en (指定可加快並提升準確度)
LANGUAGE=zh
